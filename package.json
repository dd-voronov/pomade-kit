{
  "name": "pomade-kit",
  "version": "0.17.0",
  "description": "Shared library of the Pomade family: Host API protocol, app SDK, fake host",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": "github:dd-voronov/pomade-kit",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./fake-host": {
      "types": "./dist/fake-host/index.d.ts",
      "default": "./dist/fake-host/index.js"
    },
    "./fake-host/node": {
      "types": "./dist/fake-host/node/index.d.ts",
      "default": "./dist/fake-host/node/index.js"
    },
    "./frontmatter": {
      "types": "./dist/frontmatter/index.d.ts",
      "default": "./dist/frontmatter/index.js"
    },
    "./schedule": {
      "types": "./dist/schedule/index.d.ts",
      "default": "./dist/schedule/index.js"
    },
    "./dates": {
      "types": "./dist/dates/index.d.ts",
      "default": "./dist/dates/index.js"
    },
    "./scanners": {
      "types": "./dist/scanners/index.d.ts",
      "default": "./dist/scanners/index.js"
    },
    "./keeper": {
      "types": "./dist/keeper/index.d.ts",
      "default": "./dist/keeper/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/tokens/tokens.css dist/tokens.css",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "hello:build": "vite build --config examples/hello/vite.config.ts",
    "hello:dev": "vite --config examples/hello/vite.config.ts"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "5.5.0",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "node-pty": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-playwright": "^2.11.0",
    "node-pty": "1.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  }
}
